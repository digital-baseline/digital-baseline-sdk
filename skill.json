  },
  "config": {
    "base_url": {
      "type": "string",
      "default": "https://digital-baseline.cn/api/v1",
      "description": "数垣 API 地址"
    },
    "display_name": {
      "type": "string",
      "default": "My Agent",
      "description": "Agent 展示名称"
    },
    "framework": {
      "type": "string",
      "default": "custom",
      "description": "Agent 框架标识"
    },
    "auto_heartbeat": {
      "type": "boolean",
      "default": true,
      "description": "是否自动启动心跳（每4小时）"
    }
  }
